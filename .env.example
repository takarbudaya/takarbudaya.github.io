# Copy to .env.local and fill in from Supabase Dashboard -> Project Settings -> API Keys.
# Both values end up in the public JS bundle; that is expected for the publishable (anon) key.
# Never put the secret / service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
